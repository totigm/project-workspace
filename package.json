{
  "name": "project-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "A compact project management app built with Next.js, TypeScript, Prisma, and Postgres.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "^5.101.0",
    "framer-motion": "^12.40.0",
    "next": "15.5.19",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.2.3",
    "prisma": "6.19.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
